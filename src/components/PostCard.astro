---
import { Image } from 'astro:assets';
import { SERIES } from '../consts';
import { formatDate, postUrl, readingTime, type Post } from '../utils';
import Icon from './Icon.astro';
interface Props {
  post: Post;
  delay?: number;
  eager?: boolean;
}
const { post, delay = 0, eager = false } = Astro.props;
const { title, date, description, tags, cover, series } = post.data;
const rt = readingTime(post.body);
const s = series ? SERIES[series] : undefined;
---
<article class="card post-card reveal" data-tilt style={`--d:${delay}s`} data-tags={JSON.stringify(tags)}>
  <a href={postUrl(post)} class="cover" tabindex="-1" aria-hidden="true">
    {cover ? (
      <Image src={cover} alt="" widths={[400, 640, 800]} sizes="(max-width: 700px) 100vw, 380px" loading={eager ? 'eager' : 'lazy'} />
    ) : (
      <div class="cover-fallback"><Icon name={s?.icon ?? 'pen'} size={40} /><em>{s?.en ?? 'Blog'}</em></div>
    )}
    {s && <span class="series-badge">{s.title}</span>}
  </a>
  <div class="body">
    <div class="meta">
      <span><Icon name="calendar" size={14} /> <time datetime={date.toISOString()}>{formatDate(date)}</time></span>
      <span><Icon name="clock" size={14} /> {rt.minutes} 分钟</span>
    </div>
    <h3><a href={postUrl(post)} class="stretched">{title}</a></h3>
    {description && <p class="desc">{description}</p>}
    <ul class="tag-list">
      {tags.slice(0, 3).map((t) => <li><span class="tag">#{t}</span></li>)}
    </ul>
  </div>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .cover {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-3);
  }
  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.4s;
    filter: saturate(0.9) brightness(0.88);
  }
  .post-card:hover .cover :global(img) {
    transform: scale(1.06);
    filter: saturate(1.05) brightness(1);
  }
  .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgba(8, 12, 32, 0.75));
  }
  .cover-fallback {
    width: 100%;
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 6px;
    background:
      radial-gradient(circle at 30% 20%, rgba(124, 92, 255, 0.45), transparent 55%),
      radial-gradient(circle at 80% 90%, rgba(56, 189, 248, 0.3), transparent 50%),
      linear-gradient(135deg, #0f1a45, #1a1450);
  }
  .cover-fallback :global(svg) {
    color: #c7cdfb;
  }
  .cover-fallback em {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c7cdfb;
  }
  .series-badge {
    position: absolute;
    z-index: 1;
    left: 14px;
    bottom: 12px;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 12px;
    color: #fff;
    background: rgba(90, 80, 255, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(6px);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px 20px 20px;
    flex: 1;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 13px;
    color: var(--faint);
  }
  .meta span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  h3 {
    margin: 0;
    font-size: 18px;
    line-height: 1.5;
    color: #fff;
    font-weight: 700;
  }
  .stretched::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .post-card:hover h3 a {
    color: #c7d2ff;
  }
  .desc {
    margin: 0;
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.75;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tag-list {
    margin-top: auto;
    padding-top: 4px;
  }
</style>
