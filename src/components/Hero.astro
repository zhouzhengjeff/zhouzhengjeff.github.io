---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import { ROLES, SITE } from '../consts';
import { withBase } from '../utils';
import Icon from './Icon.astro';
interface Props {
  postCount: number;
  tagCount: number;
  videoCount?: number;
}
const { postCount, tagCount, videoCount } = Astro.props;
---
<section class="hero" aria-labelledby="hero-title">
  <canvas id="hero-canvas" class="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-orb orb-1" aria-hidden="true"></div>
  <div class="hero-orb orb-2" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="hello reveal"><span class="dot" aria-hidden="true"></span> 你好，我是</p>
      <h1 id="hero-title" class="reveal" style="--d:.08s">
        <span class="name-zh">周正</span>
        <span class="name-en grad-text">Zheng Zhou</span>
      </h1>
      <p class="aka reveal" style="--d:.14s">Jeff Chou · 正哥 · 爪哇爹</p>
      <p class="roles reveal" style="--d:.2s" aria-label={ROLES.join(' / ')}>
        <span class="prompt" aria-hidden="true">&gt;</span>
        <span id="typed" class="typed" data-roles={JSON.stringify(ROLES)} aria-hidden="true">{ROLES[0]}</span><span class="caret" aria-hidden="true"></span>
      </p>
      <p class="tagline reveal" style="--d:.26s">
        享受写代码，更享受<strong>重构代码</strong>；喜欢一边读源码一边画图，
        把复杂的技术<strong>化繁为简</strong>地讲给每一位听众。
      </p>
      <div class="cta reveal" style="--d:.32s">
        <a class="btn btn-primary" href={withBase('/blog/')}><Icon name="book" /> 博客</a>
        <a class="btn" href={withBase('/about/')}><Icon name="user" /> 关于我</a>
        <a class="btn" href={SITE.github} target="_blank" rel="noopener"><Icon name="github" /> GitHub</a>
      </div>
      <dl class="stats reveal" style="--d:.38s">
        <div><dt>文章</dt><dd>{postCount}</dd></div>
        <div><dt>标签</dt><dd>{tagCount}</dd></div>
        {videoCount ? <div><dt>视频</dt><dd><a href={withBase('/videos/')}>{videoCount}</a></dd></div> : null}
        <div><dt>专注</dt><dd>Java · Python · AI Agent</dd></div>
      </dl>
    </div>

    <div class="hero-visual reveal" style="--d:.15s">
      <div class="avatar-wrap">
        <div class="ring" aria-hidden="true"></div>
        <div class="ring-glow" aria-hidden="true"></div>
        <Image src={avatar} alt="周正 Zheng Zhou 的职业照" widths={[240, 360, 480, 640]} sizes="(max-width: 820px) 240px, 360px" loading="eager" fetchpriority="high" class="avatar" />
        <span class="chip chip-1" aria-hidden="true"><i></i>Java</span>
        <span class="chip chip-4" aria-hidden="true"><i></i>Python</span>
        <span class="chip chip-2" aria-hidden="true"><i></i>AI Agent</span>
        <span class="chip chip-3" aria-hidden="true"><i></i>MCP</span>
      </div>
      <p class="signature" aria-label="签名 Zheng Zhou">Zheng Zhou</p>
    </div>
  </div>
  <a href="#about" class="scroll-hint" aria-label="向下滚动"><span></span></a>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(100svh, 980px);
    display: flex;
    align-items: center;
    padding: calc(var(--header-h) + 40px) 0 80px;
    overflow: hidden;
    isolation: isolate;
  }
  .hero::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 160px;
    z-index: -1;
    background: linear-gradient(180deg, transparent, var(--bg));
    pointer-events: none;
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }
  .hero-grid {
    position: absolute;
    inset: -2px;
    z-index: -2;
    background-image:
      linear-gradient(rgba(124, 140, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(124, 140, 255, 0.08) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 80% 70% at 60% 40%, #000 25%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 60% 40%, #000 25%, transparent 75%);
    animation: grid-pan 30s linear infinite;
  }
  @keyframes grid-pan {
    to {
      background-position: 56px 56px;
    }
  }
  .hero-orb {
    position: absolute;
    z-index: -3;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.55;
    animation: float 14s ease-in-out infinite alternate;
  }
  .orb-1 {
    width: 520px;
    height: 520px;
    right: -120px;
    top: -80px;
    background: radial-gradient(circle, #6d4dff, transparent 70%);
  }
  .orb-2 {
    width: 420px;
    height: 420px;
    left: -160px;
    bottom: -120px;
    background: radial-gradient(circle, #1d6bff, transparent 70%);
    animation-delay: -6s;
  }
  @keyframes float {
    to {
      transform: translate3d(-40px, 40px, 0) scale(1.08);
    }
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
  }
  .hello {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 14px;
    color: #c9d0f5;
    border: 1px solid var(--border);
    background: rgba(16, 24, 56, 0.6);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.6);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 10px rgba(52, 211, 153, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(52, 211, 153, 0);
    }
  }
  h1 {
    margin: 18px 0 6px;
    line-height: 1.05;
    font-weight: 900;
    letter-spacing: -0.02em;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 18px;
  }
  .name-zh {
    font-size: clamp(48px, 8vw, 92px);
    color: #fff;
  }
  .name-en {
    font-size: clamp(34px, 5.4vw, 64px);
    line-height: 1.2;
    padding-bottom: 0.08em;
    background-size: 200% auto;
    animation: shine 6s linear infinite;
  }
  @keyframes shine {
    to {
      background-position: 200% center;
    }
  }
  .aka {
    margin: 0;
    color: var(--faint);
    font-size: 15px;
    letter-spacing: 0.04em;
  }
  .roles {
    margin: 22px 0 0;
    font-family: var(--font-mono);
    font-size: clamp(18px, 2.3vw, 24px);
    color: #dfe4ff;
    min-height: 1.6em;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .prompt {
    color: var(--accent-3);
  }
  .caret {
    display: inline-block;
    width: 2px;
    height: 1.1em;
    background: var(--accent-2);
    margin-left: -6px;
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .tagline {
    margin: 18px 0 0;
    max-width: 560px;
    color: var(--muted);
    font-size: clamp(15.5px, 1.5vw, 17.5px);
    line-height: 1.85;
  }
  .tagline strong {
    color: #fff;
    font-weight: 650;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 36px;
    margin: 36px 0 0;
  }
  .stats div {
    border-left: 2px solid rgba(124, 140, 255, 0.35);
    padding-left: 14px;
  }
  .stats dt {
    font-size: 12.5px;
    color: var(--faint);
    letter-spacing: 0.08em;
  }
  .stats dd {
    margin: 2px 0 0;
    font-size: 22px;
    font-weight: 800;
    color: #fff;
  }
  .stats dd a {
    transition: color 0.2s;
  }
  .stats dd a:hover {
    color: var(--accent-3);
  }

  .hero-visual {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .avatar-wrap {
    position: relative;
    width: clamp(240px, 30vw, 380px);
    aspect-ratio: 1;
  }
  .ring {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    background: conic-gradient(from 0deg, #3b82f6, #6366f1, #a855f7, #38bdf8, #3b82f6);
    animation: spin 8s linear infinite;
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 4px), #000 calc(100% - 3px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 4px), #000 calc(100% - 3px));
  }
  .ring-glow {
    position: absolute;
    inset: -30px;
    border-radius: 50%;
    background: conic-gradient(from 180deg, rgba(59, 130, 246, 0.5), rgba(168, 85, 247, 0.55), rgba(56, 189, 248, 0.4), rgba(59, 130, 246, 0.5));
    filter: blur(40px);
    opacity: 0.55;
    z-index: -1;
    animation: spin 12s linear infinite reverse;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .avatar {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 6px solid #0a1029;
  }
  .chip {
    position: absolute;
    padding: 7px 13px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
    background: rgba(14, 22, 54, 0.85);
    border: 1px solid var(--border-strong);
    backdrop-filter: blur(8px);
    box-shadow: 0 10px 30px -10px rgba(100, 100, 255, 0.6);
    animation: bob 5s ease-in-out infinite;
  }
  .chip i {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 7px;
    border-radius: 50%;
    background: var(--accent-3);
    box-shadow: 0 0 8px var(--accent-3);
    vertical-align: 1px;
  }
  .chip-2 i {
    background: var(--accent-2);
    box-shadow: 0 0 8px var(--accent-2);
  }
  .chip-3 i {
    background: #34d399;
    box-shadow: 0 0 8px #34d399;
  }
  .chip-1 {
    left: -14%;
    top: 16%;
  }
  .chip-2 {
    right: -16%;
    top: 42%;
    animation-delay: -1.6s;
  }
  .chip-3 {
    left: 2%;
    bottom: 4%;
    animation-delay: -3.2s;
  }
  .chip-4 {
    right: -6%;
    top: 4%;
    animation-delay: -2.4s;
  }
  @keyframes bob {
    50% {
      transform: translateY(-10px);
    }
  }
  .signature {
    margin: 26px 0 0;
    font-family: var(--font-sig);
    font-weight: 400;
    font-size: clamp(42px, 4.4vw, 58px);
    line-height: 1.25;
    padding: 0 0.2em 0.1em;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transform: rotate(-4deg);
  }
  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 22px;
    transform: translateX(-50%);
    width: 26px;
    height: 42px;
    border: 2px solid var(--border-strong);
    border-radius: 14px;
  }
  .scroll-hint span {
    position: absolute;
    left: 50%;
    top: 8px;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--accent-2);
    animation: scrolly 1.8s ease-in-out infinite;
  }
  @keyframes scrolly {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @media (max-width: 820px) {
    .hero {
      min-height: auto;
      padding-top: calc(var(--header-h) + 28px);
    }
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: left;
    }
    .hero-visual {
      order: -1;
    }
    .avatar-wrap {
      width: 200px;
    }
    .chip {
      font-size: 11.5px;
      padding: 5px 10px;
    }
    .chip-1 {
      left: -26%;
    }
    .chip-2 {
      right: -30%;
    }
    .chip-4 {
      right: -18%;
      top: 2%;
    }
    .signature {
      margin-top: 18px;
    }
    .scroll-hint {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .caret {
      display: none;
    }
  }
</style>

<script>
  // ---------- 打字效果 ----------
  const typed = document.getElementById('typed');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (typed) {
    const roles: string[] = JSON.parse(typed.dataset.roles || '[]');
    if (reduce) {
      typed.textContent = roles.join(' / ');
    } else {
      let i = 0;
      let n = roles[0].length;
      let deleting = true;
      const tick = () => {
        const word = roles[i];
        typed.textContent = word.slice(0, n);
        let delay = deleting ? 45 : 110;
        if (!deleting && n === word.length) {
          deleting = true;
          delay = 1800;
        } else if (deleting && n === 0) {
          deleting = false;
          i = (i + 1) % roles.length;
          delay = 300;
        } else {
          n += deleting ? -1 : 1;
        }
        setTimeout(tick, delay);
      };
      setTimeout(tick, 2000);
    }
  }

  // ---------- 粒子网络画布 ----------
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');
  if (canvas && ctx) {
    type P = { x: number; y: number; vx: number; vy: number; r: number; c: string };
    const colors = ['124,140,255', '167,139,250', '56,189,248'];
    let w = 0,
      h = 0,
      dpr = 1,
      pts: P[] = [],
      raf = 0,
      running = false;
    const mouse = { x: -9999, y: -9999 };
    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.round(Math.min(90, Math.max(28, (w * h) / 16000)));
      pts = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.35,
        vy: (Math.random() - 0.5) * 0.35,
        r: Math.random() * 1.6 + 0.6,
        c: colors[(Math.random() * colors.length) | 0],
      }));
    };
    const LINK = 130;
    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      for (const p of pts) {
        if (!reduce) {
          p.x += p.vx;
          p.y += p.vy;
          if (p.x < 0 || p.x > w) p.vx *= -1;
          if (p.y < 0 || p.y > h) p.vy *= -1;
          const dx = p.x - mouse.x,
            dy = p.y - mouse.y,
            d = Math.hypot(dx, dy);
          if (d < 140 && d > 0) {
            p.x += (dx / d) * 0.8;
            p.y += (dy / d) * 0.8;
          }
        }
      }
      for (let i = 0; i < pts.length; i++) {
        const a = pts[i];
        for (let j = i + 1; j < pts.length; j++) {
          const b = pts[j];
          const dx = a.x - b.x,
            dy = a.y - b.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < LINK * LINK) {
            const o = 1 - Math.sqrt(d2) / LINK;
            ctx.strokeStyle = `rgba(124,140,255,${o * 0.28})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
        }
      }
      for (const p of pts) {
        ctx.beginPath();
        ctx.fillStyle = `rgba(${p.c},0.9)`;
        ctx.shadowColor = `rgba(${p.c},0.9)`;
        ctx.shadowBlur = 8;
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.shadowBlur = 0;
      if (running) raf = requestAnimationFrame(draw);
    };
    const start = () => {
      if (running || reduce) return;
      running = true;
      raf = requestAnimationFrame(draw);
    };
    const stop = () => {
      running = false;
      cancelAnimationFrame(raf);
    };
    resize();
    draw();
    let rt: number | undefined;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = window.setTimeout(() => {
        resize();
        draw();
      }, 150);
    });
    canvas.parentElement?.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      mouse.x = e.clientX - r.left;
      mouse.y = e.clientY - r.top;
    });
    canvas.parentElement?.addEventListener('pointerleave', () => {
      mouse.x = mouse.y = -9999;
    });
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop())).observe(canvas);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  }
</script>
