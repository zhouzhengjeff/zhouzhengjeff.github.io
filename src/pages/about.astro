---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import avatar from '../assets/avatar.png';
import { ABOUT } from '../data/about';
import { SITE, SKILLS } from '../consts';
---
<BaseLayout title="关于我" description="你好，我是周正（Jeff Chou），一名程序员、Java / Python 讲师和创作者，也是一个 Java / Python 布道者。">
  <section class="page-hero">
    <div class="container about-hero">
      <div class="ava">
        <Image src={avatar} alt="周正的职业照" widths={[200, 320, 400]} sizes="200px" loading="eager" />
      </div>
      <div>
        <span class="eyebrow">About</span>
        <h1>关于我 <span class="grad-text">周正</span></h1>
        <p>Jeff Chou · 正哥 · 爪哇爹 — 程序员 / Java &amp; Python &amp; AI Agent 讲师 / 创作者</p>
      </div>
    </div>
  </section>
  <section class="container about-body">
    <div class="prose">
      <blockquote>
        {ABOUT.slice(0, 2).map((p) => <p>{p}</p>)}
      </blockquote>
      {ABOUT.slice(2).map((p) => <p>{p}</p>)}

      <h2 id="stack">技术栈</h2>
      {SKILLS.map((g) => (
        <p><strong>{g.group}：</strong>{g.items.join(' · ')}</p>
      ))}

      <h2 id="contact">联系我</h2>
      <ul class="contact-list">
        <li><Icon name="mail" /> 邮箱：<a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><Icon name="github" /> GitHub：<a href={SITE.github} target="_blank" rel="noopener">github.com/zhouzhengjeff</a></li>
        <li><Icon name="x" /> X / Twitter：<a href={SITE.x} target="_blank" rel="noopener">{SITE.xHandle}</a></li>
        <li><Icon name="mic" /> 播客：<a href={SITE.podcast} target="_blank" rel="noopener">代码之外 Beyond Code</a></li>
      </ul>
      <p class="sig">Zheng Zhou</p>
    </div>
  </section>
</BaseLayout>
<style>
  .about-hero {
    display: flex;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }
  .ava {
    position: relative;
    width: 140px;
    height: 140px;
    flex: none;
    border-radius: 50%;
    padding: 4px;
    background: conic-gradient(from 0deg, #3b82f6, #6366f1, #a855f7, #38bdf8, #3b82f6);
    box-shadow: 0 0 40px rgba(124, 92, 255, 0.5);
  }
  .ava :global(img) {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--bg);
  }
  .about-body {
    max-width: 860px;
    padding-bottom: 100px;
  }
  .contact-list {
    list-style: none;
    padding: 0 !important;
  }
  .contact-list li {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .contact-list :global(svg) {
    color: var(--accent);
  }
  .sig {
    margin-top: 2em !important;
    font-family: var(--font-sig);
    font-weight: 400;
    font-size: 54px;
    line-height: 1.3;
    padding: 0 0.15em 0.1em 0;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
